# Local-only Compose values. Replace these before exposing any service beyond localhost.
POSTGRES_PASSWORD=demo_only_change_me
GRAFANA_PASSWORD=demo_only_change_me
MOCK_SERVICE_TOKEN=local-demo-service
MOCK_FAILURE_RATE=0.05
MOCK_LATENCY_MIN_MS=100
MOCK_LATENCY_MAX_MS=3000

# Local Ollama (the backend runs in Docker and reaches Ollama on the Mac host).
LLM_BASE_URL=http://host.docker.internal:11435/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b

# Optional provider-compatible raw-audio STT and JSON text-to-audio TTS endpoints.
STT_ENDPOINT=
TTS_ENDPOINT=
VOICE_PROVIDER_API_KEY=
